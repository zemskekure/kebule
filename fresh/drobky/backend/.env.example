# Supabase Configuration (for Strategy App authentication)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Google OAuth (for Signal Lite PWA authentication)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Allowed email domains (comma-separated)
ALLOWED_DOMAINS=ambiente.cz,amanual.cz

# Server
PORT=3001
# For Render: use PORT=10000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
# For Render: use your deployed frontend URL, e.g., https://drobky.onrender.com

# Additional allowed origins for CORS (comma-separated, optional)
# ALLOWED_ORIGINS=https://your-other-app.onrender.com

# Claude API for brand generation (optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Email to Brand IDs mapping (JSON string)
# BRAND_MAPPING={"user@ambiente.cz":["brand1","brand2"],"other@amanual.cz":["brand3"]}
